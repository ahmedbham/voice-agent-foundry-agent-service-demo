{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "voiceLiveLocation": { "value": "${AZURE_LOCATION=eastus2}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT}" },
    "foundryResourceGroupName": { "value": "${FOUNDRY_RESOURCE_GROUP}" },
    "foundryResourceName": { "value": "${FOUNDRY_RESOURCE_NAME}" },
    "foundryProjectName": { "value": "${FOUNDRY_PROJECT_NAME}" },
    "modelDeploymentName": { "value": "${MODEL_DEPLOYMENT_NAME=gpt-4.1-mini}" },
    "agentName": { "value": "${AGENT_NAME=MyVoiceAgent}" }
  }
}
